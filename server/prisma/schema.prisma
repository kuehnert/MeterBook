// MeterBook – Datenmodell
//
// Ein Zähler (Meter) ist eine Messstelle, z. B. "Heizstrom". Er hat ein oder mehrere
// Zählwerke (Register), z. B. HT und NT. Ablesungen (Reading) gehören immer zu einem
// Zählwerk. Wird das Gerät getauscht, hält ein MeterExchange Endstand des alten und
// Anfangsstand des neuen Geräts fest, damit die Verbrauchsreihe durchgängig bleibt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  /// ADMIN | USER
  role         String         @default("USER")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  meters       Meter[]
  photos       Photo[]
  refreshTokens RefreshToken[]
  authTokens    AuthToken[]
  /// Erinnerung ans Ablesen: OFF | WEEKLY (montags 9 Uhr) | MONTHLY (am 1. um 9 Uhr)
  reminderInterval  String    @default("OFF")
  /// Erinnerung zusätzlich per E-Mail (eine Mail je Erinnerung)
  reminderEmail     Boolean   @default(true)
  /// Erinnerungen bis einschließlich dieses Termins überspringen
  reminderSkipUntil DateTime?
  /// Termin, für den zuletzt eine Erinnerungs-Mail verschickt wurde
  reminderMailedFor DateTime?
}

/// Einmal-Links per E-Mail: Einladung (Passwort festlegen) und Passwort zurücksetzen
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  /// INVITE | RESET
  purpose   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  device    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Meter {
  id                String           @id @default(cuid())
  userId            String
  name              String
  /// ELECTRICITY | WATER | GAS | HEAT | OTHER
  medium            String
  /// Symbol: ELECTRICITY | HEATING | WATER | GAS | HEAT | OTHER (leer = wie medium)
  icon              String?
  unit              String
  serialNumber      String?
  location          String?
  notes             String?
  /// Zusätzliche Hinweise für die automatische Erkennung, z. B. "rote Ziffern sind Nachkommastellen"
  ocrHint           String?
  /// Beginn der Abrechnungsperiode (Monat 1–12, Tag 1–28)
  billingStartMonth Int              @default(1)
  billingStartDay   Int              @default(1)
  /// Eigener Ablese-Rhythmus (OFF | WEEKLY | MONTHLY | QUARTERLY | YEARLY); null = Standard des Nutzers
  reminderInterval  String?
  archived          Boolean          @default(false)
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  registers         Register[]
  tariffs           Tariff[]
  advancePayments   AdvancePayment[]
  photos            Photo[]

  @@index([userId])
}

model Register {
  id         String            @id @default(cuid())
  meterId    String
  name       String
  /// Kurzbezeichnung, z. B. HT, NT, 1.8.0
  code       String?
  /// Anzahl der Nachkommastellen auf dem Zählwerk
  decimals   Int               @default(1)
  sortOrder  Int               @default(0)
  meter      Meter             @relation(fields: [meterId], references: [id], onDelete: Cascade)
  readings   Reading[]
  exchanges  MeterExchange[]
  prices     TariffComponent[]

  @@index([meterId])
}

model Reading {
  id            String   @id @default(cuid())
  registerId    String
  readAt        DateTime
  value         Decimal
  /// MANUAL | PHOTO | IMPORT
  source        String   @default("MANUAL")
  photoId       String?
  /// Wert, den die automatische Erkennung vorgeschlagen hat
  ocrValue      Decimal?
  ocrConfidence Float?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  register      Register @relation(fields: [registerId], references: [id], onDelete: Cascade)
  photo         Photo?   @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([registerId, readAt])
}

model Photo {
  id        String    @id @default(cuid())
  userId    String
  /// null = noch keinem Zähler zugeordnet (automatische Zuordnung fehlgeschlagen)
  meterId   String?
  takenAt   DateTime
  width     Int?
  height    Int?
  /// NONE | PENDING (Erkennung läuft im Hintergrund) | DONE | FAILED
  ocrStatus String    @default("NONE")
  /// JSON mit dem Ergebnis der Erkennung
  ocrResult String?
  /// Auf den Ziffernbereich zugeschnitten (Boxen in ocrResult beziehen sich dann auf den Ausschnitt)
  cropped   Boolean   @default(false)
  /// Nutzer wollte das ganze Foto behalten – auch nachträglich nicht zuschneiden
  keepFull  Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  meter     Meter?    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  readings  Reading[]

  @@index([meterId])
}

model MeterExchange {
  id              String   @id @default(cuid())
  registerId      String
  exchangedAt     DateTime
  oldFinalValue   Decimal
  newInitialValue Decimal
  note            String?
  createdAt       DateTime @default(now())
  register        Register @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@index([registerId])
}

/// Ein Tarif gilt ab validFrom bis zum validFrom des nächsten Tarifs desselben Zählers.
model Tariff {
  id                String            @id @default(cuid())
  meterId           String
  name              String?
  /// Stromanbieter bzw. Versorger, z. B. nach einem Wechsel
  provider          String?
  validFrom         DateTime
  /// Grundpreis in € pro Jahr (brutto), wird zeitanteilig verteilt
  basePricePerYear  Decimal           @default(0)
  createdAt         DateTime          @default(now())
  meter             Meter             @relation(fields: [meterId], references: [id], onDelete: Cascade)
  components        TariffComponent[]
  bonuses           TariffBonus[]

  @@index([meterId, validFrom])
}

/// Bonus beim Anbieterwechsel (z. B. Neukunden- oder Sofortbonus). Wird über das erste
/// Vertragsjahr ab validFrom des Tarifs verteilt von den Kosten abgezogen.
model TariffBonus {
  id       String  @id @default(cuid())
  tariffId String
  label    String
  /// € (brutto)
  amount   Decimal
  tariff   Tariff  @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  @@index([tariffId])
}

/// Arbeitspreis je Einheit für ein Zählwerk. Mehrere Komponenten je Zählwerk sind
/// möglich, z. B. Frischwasser und Abwasser.
model TariffComponent {
  id           String   @id @default(cuid())
  tariffId     String
  registerId   String
  label        String
  /// € pro Einheit (brutto)
  pricePerUnit Decimal
  tariff       Tariff   @relation(fields: [tariffId], references: [id], onDelete: Cascade)
  register     Register @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@index([tariffId])
}

/// Monatlicher Abschlag an den Versorger, gültig ab validFrom.
model AdvancePayment {
  id             String   @id @default(cuid())
  meterId        String
  validFrom      DateTime
  amountPerMonth Decimal
  note           String?
  meter          Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@index([meterId, validFrom])
}
