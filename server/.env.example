# Datenbank (SQLite-Datei)
DATABASE_URL="file:../data/meterbook.db"
# Ablage für Fotos
DATA_DIR="../data"
# Port des HTTP-Servers
PORT=3000
# Geheimnis für die Anmelde-Tokens – unbedingt ändern (z. B. `openssl rand -hex 32`)
JWT_SECRET="change-me"
# Erster Administrator – wird nur angelegt, wenn noch kein Nutzer existiert
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-too"
ADMIN_NAME="Admin"
# Zählerstand-Erkennung per Claude (leer lassen = keine automatische Erkennung)
ANTHROPIC_API_KEY=""
OCR_MODEL="claude-opus-5-5"
# Verzeichnis mit dem gebauten Web-Frontend (leer = nicht ausliefern)
WEB_DIR="../web/dist"
TZ="Europe/Berlin"
