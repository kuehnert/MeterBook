# Geheimnis für die Anmelde-Tokens – zufällig erzeugen, z. B.:  openssl rand -hex 32
JWT_SECRET=

# Erster Administrator – wird nur beim allerersten Start angelegt.
# Danach Passwort in der Web-Oberfläche unter "Einstellungen" ändern.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Automatische Erkennung der Zählerstände per Claude (leer = aus)
ANTHROPIC_API_KEY=
# Modell für die Erkennung
OCR_MODEL=claude-opus-5-5

# --- Sicherung ---------------------------------------------------------------
# Automatische Sicherung (mit Fotos) alle n Stunden nach /data/backups; 0 = aus
BACKUP_INTERVAL_HOURS=24
# So viele automatische Sicherungen bleiben erhalten
BACKUP_KEEP=14
# Token für die Sicherung per Skript (GET /api/backup); leer = aus. Erzeugen: openssl rand -hex 32
BACKUP_TOKEN=

# --- Fotos -------------------------------------------------------------------
# Fotos nach so vielen Tagen löschen (die Ablesungen bleiben); 0 = nie
PHOTO_RETENTION_DAYS=400

# Port auf dem Host
HOST_PORT=3000
